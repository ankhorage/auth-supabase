{
  "name": "@ankhorage/auth-supabase",
  "type": "module",
  "version": "2.0.2",
  "description": "Supabase adapter implementing the provider-neutral Ankhorage auth port.",
  "homepage": "https://github.com/ankhorage/auth-supabase#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/auth-supabase/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/auth-supabase.git"
  },
  "keywords": [
    "adapter",
    "ankhorage",
    "auth",
    "authentication",
    "gotrue",
    "oauth",
    "secret-store",
    "session",
    "supabase",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox && ankhorage-prettier --write paradox README.md",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.21",
    "@ankhorage/paradox": "^0.3.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ankhorage/auth": "^0.1.3",
    "@ankhorage/contracts": "^26.0.1",
    "@noble/hashes": "2.4.0"
  },
  "packageManager": "bun@1.4.2"
}
